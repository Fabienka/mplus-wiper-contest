# Časová zóna serveru. Aplikace formátuje i parsuje všechny termíny v systémové
# zóně procesu, takže tohle MUSÍ být proměnná prostředí hostingu - řádek tady
# je jen připomínka, Node si zónu čte dřív, než se .env vůbec načte.
TZ=Europe/Prague

# PostgreSQL připojení
DATABASE_URL="postgresql://user:password@localhost:5432/wow_mplus_app"

# NextAuth
NEXTAUTH_SECRET="vygeneruj-nahodny-retezec-napr-pomoci-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Hesla, se kterými seed zakládá admina a moderátora. V dev se dají vynechat -
# použijí se výchozí z prisma/seed.ts. S NODE_ENV=production se ale výchozí
# hesla nepoužijí a seed bez těchhle proměnných skončí chybou (min. 12 znaků).
# SEED_ADMIN_PASSWORD=
# SEED_MODERATOR_PASSWORD=

# Discord webhook pro notifikace (Nastavení kanálu -> Integrace -> Webhooky).
# Prázdná hodnota = notifikace se neposílají ani nezapisují do fronty, což je
# pro vývoj správně - jinak by do ostrého kanálu chodily testovací zprávy.
DISCORD_WEBHOOK_URL=""

# Raider.io API base (veřejné, bez klíče)
RAIDERIO_API_BASE="https://raider.io/api/v1"
