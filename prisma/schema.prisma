generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  USER
}

enum SpecRole {
  TANK
  HEALER
  DPS
}

enum SeasonStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ACTIVE
  CLOSED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  SUBSTITUTE
  REMOVED
}

enum ShuffleRunStatus {
  PROPOSED
  APPLIED
}

enum MatchStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  EVALUATED
}

enum ResultSource {
  RAIDERIO
  SCREENSHOT
}

enum DiscordEventType {
  NEW_REGISTRATION
  SHUFFLE_RESULT
  UPCOMING_MATCH
  MATCH_RESULT
}

enum DiscordEventStatus {
  PENDING
  SENT
  FAILED
}

// ---------- Core ----------

model Season {
  id                    String       @id @default(cuid())
  name                  String
  status                SeasonStatus @default(DRAFT)
  registrationOpenedAt  DateTime?
  registrationClosedAt  DateTime?
  scoringConfig         Json         @default("{}")
  createdAt             DateTime     @default(now())

  dungeons      SeasonDungeon[]
  registrations SeasonRegistration[]
  teams         Team[]
  teamMembers   TeamMembership[]
  shuffleRuns   ShuffleRun[]
}

model SeasonDungeon {
  id           String  @id @default(cuid())
  seasonId     String
  season       Season  @relation(fields: [seasonId], references: [id])
  dungeonName  String
  abbreviation String
  // Časový limit klíče v sekundách - pro sezónu se doplňuje ručně, dokud není známý.
  timeLimitSeconds Int?
  coefficient  Float
  isActive     Boolean @default(true)

  @@index([seasonId])
  @@unique([seasonId, dungeonName])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  email        String?
  discordNick  String?
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())

  character           Character?
  reviewedRegistrations SeasonRegistration[] @relation("ReviewedBy")
  auditLogs            AuditLog[]
  shuffleRunsExecuted  ShuffleRun[]
  verifiedResults      MatchResult[]        @relation("VerifiedBy")
}

model Character {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  raiderioUrl    String
  characterName  String
  realm          String
  faction        String?
  guildName      String?
  class          String?
  specRole       SpecRole
  rioScore       Float?
  lastSyncedAt   DateTime?

  registrations   SeasonRegistration[]
  teamMemberships TeamMembership[]
  proposedMatches Match[]              @relation("ProposedBy")

  @@index([userId])
}

// ---------- Registration ----------

model SeasonRegistration {
  id                String              @id @default(cuid())
  seasonId          String
  season            Season              @relation(fields: [seasonId], references: [id])
  characterId       String
  character         Character           @relation(fields: [characterId], references: [id])
  status            RegistrationStatus  @default(PENDING)
  formAnswers       Json
  raiderioSnapshot  Json
  reviewedById      String?
  reviewedBy        User?               @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime            @default(now())

  @@index([seasonId, status])
  @@unique([seasonId, characterId])
}

// ---------- Teams ----------

model Team {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  name      String
  createdAt DateTime @default(now())

  members TeamMembership[]
  matches Match[]

  @@index([seasonId])
}

model TeamMembership {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  teamId      String?
  team        Team?             @relation(fields: [teamId], references: [id])
  characterId String
  character   Character         @relation(fields: [characterId], references: [id])
  roleInTeam  SpecRole
  status      MembershipStatus  @default(ACTIVE)
  joinedAt    DateTime          @default(now())
  removedAt   DateTime?

  @@index([seasonId, teamId])
  @@index([characterId])
}

// ---------- Shuffle ----------

model ShuffleRun {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  executedById String
  executedBy  User              @relation(fields: [executedById], references: [id])
  executedAt  DateTime          @default(now())
  status      ShuffleRunStatus  @default(PROPOSED)

  proposals ShuffleProposal[]

  @@index([seasonId])
}

model ShuffleProposal {
  id              String     @id @default(cuid())
  shuffleRunId    String
  shuffleRun      ShuffleRun @relation(fields: [shuffleRunId], references: [id])
  variantNumber   Int
  score           Float
  ruleViolations  Json
  teamAssignments Json

  @@index([shuffleRunId])
}

// ---------- Matches ----------

model Match {
  id            String      @id @default(cuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  proposedById  String
  proposedBy    Character   @relation("ProposedBy", fields: [proposedById], references: [id])
  windowStart   DateTime
  windowEnd     DateTime
  status        MatchStatus @default(PROPOSED)
  // TBD: kdo termín potvrzuje - pole připravené, logika potvrzení se doladí později
  confirmedById String?

  results MatchResult[]

  @@index([teamId])
}

model MatchResult {
  id                 String        @id @default(cuid())
  matchId            String
  match              Match         @relation(fields: [matchId], references: [id])
  dungeonName        String
  keyLevel           Int
  clearTimeSeconds   Int
  source             ResultSource
  screenshotUrl      String?
  rawRaiderioData     Json?
  isValid            Boolean       @default(false)
  invalidReason      String?
  isOfficial         Boolean       @default(false)
  points             Float?
  verifiedById       String?
  verifiedBy         User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt          DateTime      @default(now())

  @@index([matchId])
}

// ---------- Audit & Discord ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actionType String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model DiscordEvent {
  id        String             @id @default(cuid())
  eventType DiscordEventType
  payload   Json
  sentAt    DateTime?
  status    DiscordEventStatus @default(PENDING)
  createdAt DateTime           @default(now())
}
