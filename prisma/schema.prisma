generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  // Moderátor = běžný uživatel + potvrzování zápisného a schvalování termínů.
  // Nesmí schvalovat/zamítat registrace ani sahat na sezónu, shuffle a týmy.
  MODERATOR
  USER
}

enum SpecRole {
  TANK
  HEALER
  DPS
}

enum SeasonStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ACTIVE
  CLOSED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  SUBSTITUTE
  REMOVED
}

enum ShuffleRunStatus {
  PROPOSED
  APPLIED
}

enum MatchStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  EVALUATED
}

enum ResultSource {
  RAIDERIO
  SCREENSHOT
}

enum DiscordEventType {
  NEW_REGISTRATION
  SHUFFLE_RESULT
  UPCOMING_MATCH
  MATCH_RESULT
}

enum DiscordEventStatus {
  PENDING
  SENT
  FAILED
}

// ---------- Core ----------

model Season {
  id                    String       @id @default(cuid())
  name                  String
  status                SeasonStatus @default(DRAFT)
  registrationOpenedAt  DateTime?
  registrationClosedAt  DateTime?
  // Slug sezóny na Raider.io (např. "season-mn-2") - podle něj se stahují
  // časové limity dungeonů a výsledky běhů.
  raiderioSeasonSlug    String?
  scoringConfig         Json         @default("{}")
  createdAt             DateTime     @default(now())

  dungeons      SeasonDungeon[]
  registrations SeasonRegistration[]
  teams         Team[]
  teamMembers   TeamMembership[]
  shuffleRuns   ShuffleRun[]
  availabilities Availability[]
}

model SeasonDungeon {
  id           String  @id @default(cuid())
  seasonId     String
  season       Season  @relation(fields: [seasonId], references: [id])
  dungeonName  String
  abbreviation String
  // Časový limit klíče v sekundách - pro sezónu se doplňuje ručně, dokud není známý.
  timeLimitSeconds Int?
  /// Násobitel časového bonusu. 1 = bez zvýhodnění; vyšší hodnota dungeon
  /// zvýhodní (např. kvůli nucenému čekání na NPC, které nikdo neovlivní).
  /// Bonus je vždy useknutý ve 100, aby vyšší klíč nemohl prohrát s nižším.
  bonusMultiplier Float  @default(1)
  isActive     Boolean @default(true)

  @@index([seasonId])
  @@unique([seasonId, dungeonName])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  email        String?
  discordNick  String?
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())

  character           Character?
  reviewedRegistrations SeasonRegistration[] @relation("ReviewedBy")
  confirmedEntryFees   SeasonRegistration[] @relation("EntryFeeConfirmedBy")
  auditLogs            AuditLog[]
  shuffleRunsExecuted  ShuffleRun[]
  verifiedResults      MatchResult[]        @relation("VerifiedBy")
  confirmedMatches     Match[]              @relation("ConfirmedMatches")
}

model Character {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  raiderioUrl    String
  characterName  String
  realm          String
  faction        String?
  guildName      String?
  class          String?
  // Konkrétní specializace (např. "Beast Mastery") - podle ní se v shuffle
  // určuje ranged/melee, battle rez a bloodlust (viz src/lib/wow-specs.ts).
  // Nullable kvůli postavám založeným před zavedením pole a kvůli specům,
  // které Raider.io nevrátí.
  wowSpec        String?
  specRole       SpecRole
  rioScore       Float?
  lastSyncedAt   DateTime?

  registrations   SeasonRegistration[]
  teamMemberships TeamMembership[]
  proposedMatches Match[]              @relation("ProposedBy")
  availabilities  Availability[]

  @@index([userId])
}

// ---------- Registration ----------

model SeasonRegistration {
  id                String              @id @default(cuid())
  seasonId          String
  season            Season              @relation(fields: [seasonId], references: [id])
  characterId       String
  character         Character           @relation(fields: [characterId], references: [id])
  status            RegistrationStatus  @default(PENDING)
  formAnswers       Json
  raiderioSnapshot  Json
  reviewedById      String?
  reviewedBy        User?               @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  rejectionReason   String?
  // Zápisné se platí ve hře (poslané zlato), takže ho aplikace neumí ověřit
  // sama - moderátor nebo admin potvrdí, že peníze dorazily. Prázdné
  // entryFeePaidAt znamená nezaplaceno.
  entryFeePaidAt        DateTime?
  entryFeeConfirmedById String?
  entryFeeConfirmedBy   User?    @relation("EntryFeeConfirmedBy", fields: [entryFeeConfirmedById], references: [id])
  entryFeeNote          String?
  createdAt         DateTime            @default(now())

  @@index([seasonId, status])
  @@unique([seasonId, characterId])
}

// ---------- Teams ----------

model Team {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  name      String
  createdAt DateTime @default(now())

  members TeamMembership[]
  matches Match[]

  @@index([seasonId])
}

model TeamMembership {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  teamId      String?
  team        Team?             @relation(fields: [teamId], references: [id])
  characterId String
  character   Character         @relation(fields: [characterId], references: [id])
  roleInTeam  SpecRole
  status      MembershipStatus  @default(ACTIVE)
  joinedAt    DateTime          @default(now())
  removedAt   DateTime?

  @@index([seasonId, teamId])
  @@index([characterId])
}

// ---------- Shuffle ----------

model ShuffleRun {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  executedById String
  executedBy  User              @relation(fields: [executedById], references: [id])
  executedAt  DateTime          @default(now())
  status      ShuffleRunStatus  @default(PROPOSED)
  // Seed generátoru náhodných čísel - se stejným seedem a stejným vstupem
  // vrátí shuffle stejné varianty (kvůli dohledání, proč vyšlo, co vyšlo).
  seed        Int?

  proposals ShuffleProposal[]

  @@index([seasonId])
}

model ShuffleProposal {
  id              String     @id @default(cuid())
  shuffleRunId    String
  shuffleRun      ShuffleRun @relation(fields: [shuffleRunId], references: [id])
  variantNumber   Int
  score           Float
  ruleViolations  Json
  teamAssignments Json

  @@index([shuffleRunId])
}

// ---------- Matches ----------

model Match {
  id            String      @id @default(cuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  proposedById  String
  proposedBy    Character   @relation("ProposedBy", fields: [proposedById], references: [id])
  windowStart   DateTime
  windowEnd     DateTime
  status        MatchStatus @default(PROPOSED)
  /// Poznámka od toho, kdo termín navrhl (např. "sejdeme se na Discordu").
  note          String?
  // Termín potvrzuje moderátor nebo admin - hráči si ho jen navrhnou mezi sebou.
  confirmedById String?
  confirmedBy   User?       @relation("ConfirmedMatches", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())

  results MatchResult[]

  @@index([teamId])
  @@index([windowStart])
}

/// Kdy má hráč čas. Z překryvů dostupností celého týmu se skládá návrh termínu.
model Availability {
  id          String    @id @default(cuid())
  seasonId    String
  season      Season    @relation(fields: [seasonId], references: [id])
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  start       DateTime
  end         DateTime
  note        String?
  createdAt   DateTime  @default(now())

  @@index([seasonId, characterId])
  @@index([seasonId, start])
}

model MatchResult {
  id                 String        @id @default(cuid())
  matchId            String
  match              Match         @relation(fields: [matchId], references: [id])
  dungeonName        String
  keyLevel           Int
  clearTimeSeconds   Int
  source             ResultSource
  screenshotUrl      String?
  /// Id běhu na Raider.io - podle něj se pozná, že už je běh nahraný,
  /// a dá se z něj složit zpětný odkaz.
  raiderioRunId      Int?
  rawRaiderioData     Json?
  isValid            Boolean       @default(false)
  invalidReason      String?
  isOfficial         Boolean       @default(false)
  points             Float?
  verifiedById       String?
  verifiedBy         User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt          DateTime      @default(now())

  @@index([matchId])
  @@unique([matchId, raiderioRunId])
}

// ---------- Audit & Discord ----------

/// Neúspěšná přihlášení pro omezení počtu pokusů. Úspěšná se nezaznamenávají -
/// po přihlášení se záznamy toho jména mažou.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// Vždycky malými písmeny, ať limit neobejde jiná velikost písmen.
  username  String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ipAddress, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actionType String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model DiscordEvent {
  id        String             @id @default(cuid())
  eventType DiscordEventType
  payload   Json
  sentAt    DateTime?
  status    DiscordEventStatus @default(PENDING)
  createdAt DateTime           @default(now())
}
