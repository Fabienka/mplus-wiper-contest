generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  // Moderátor = běžný uživatel + provoz sezóny: zápisné, termíny, přesuny
  // v týmech a vratné úpravy sezóny (název, stav registrace, aktivní dungeony).
  // Nesmí schvalovat/zamítat registrace, pouštět shuffle, měnit pravidla
  // bodování ani mazat. Přesnou matici drží src/lib/permissions.ts.
  MODERATOR
  USER
}

enum SpecRole {
  TANK
  HEALER
  DPS
}

enum SeasonStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ACTIVE
  CLOSED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  SUBSTITUTE
  REMOVED
}

enum ShuffleRunStatus {
  PROPOSED
  APPLIED
}

enum MatchStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  EVALUATED
}

enum ResultSource {
  RAIDERIO
  SCREENSHOT
}

enum DiscordEventType {
  NEW_REGISTRATION
  SHUFFLE_RESULT
  UPCOMING_MATCH
  MATCH_RESULT
}

enum DiscordEventStatus {
  PENDING
  SENT
  FAILED
}

// ---------- Core ----------

model Season {
  id                    String       @id @default(cuid())
  name                  String
  status                SeasonStatus @default(DRAFT)
  registrationOpenedAt  DateTime?
  registrationClosedAt  DateTime?
  // Slug sezóny na Raider.io (např. "season-mn-2") - podle něj se stahují
  // časové limity dungeonů a výsledky běhů.
  raiderioSeasonSlug    String?
  scoringConfig         Json         @default("{}")
  createdAt             DateTime     @default(now())

  dungeons      SeasonDungeon[]
  registrations SeasonRegistration[]
  teams         Team[]
  teamMembers   TeamMembership[]
  shuffleRuns   ShuffleRun[]
  availabilities Availability[]
}

model SeasonDungeon {
  id           String  @id @default(cuid())
  seasonId     String
  season       Season  @relation(fields: [seasonId], references: [id])
  dungeonName  String
  abbreviation String
  // Časový limit klíče v sekundách - pro sezónu se doplňuje ručně, dokud není známý.
  timeLimitSeconds Int?
  /// Násobitel časového bonusu. 1 = bez zvýhodnění; vyšší hodnota dungeon
  /// zvýhodní (např. kvůli nucenému čekání na NPC, které nikdo neovlivní).
  /// Bonus je vždy useknutý ve 100, aby vyšší klíč nemohl prohrát s nižším.
  bonusMultiplier Float  @default(1)
  isActive     Boolean @default(true)

  @@index([seasonId])
  @@unique([seasonId, dungeonName])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  email        String?
  discordNick  String?
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())

  character           Character?
  reviewedRegistrations SeasonRegistration[] @relation("ReviewedBy")
  confirmedEntryFees   SeasonRegistration[] @relation("EntryFeeConfirmedBy")
  auditLogs            AuditLog[]
  shuffleRunsExecuted  ShuffleRun[]
  verifiedResults      MatchResult[]        @relation("VerifiedBy")
  confirmedMatches     Match[]              @relation("ConfirmedMatches")
  createdMatches       Match[]              @relation("CreatedMatches")
  passwordResets       PasswordResetToken[] @relation("ResetForUser")
  issuedPasswordResets PasswordResetToken[] @relation("ResetIssuedBy")
  teamNotes            TeamNote[]           @relation("TeamNotes")
}

model Character {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  raiderioUrl    String
  characterName  String
  realm          String
  faction        String?
  guildName      String?
  class          String?
  // Konkrétní specializace (např. "Beast Mastery") - podle ní se v shuffle
  // určuje ranged/melee, battle rez a bloodlust (viz src/lib/wow-specs.ts).
  // Nullable kvůli postavám založeným před zavedením pole a kvůli specům,
  // které Raider.io nevrátí.
  wowSpec        String?
  specRole       SpecRole
  rioScore       Float?
  lastSyncedAt   DateTime?

  registrations   SeasonRegistration[]
  teamMemberships TeamMembership[]
  proposedMatches Match[]              @relation("ProposedBy")
  availabilities  Availability[]
  recordedRerolls TeamReroll[]         @relation("RecordedRerolls")

  @@index([userId])
}

// ---------- Registration ----------

model SeasonRegistration {
  id                String              @id @default(cuid())
  seasonId          String
  season            Season              @relation(fields: [seasonId], references: [id])
  characterId       String
  character         Character           @relation(fields: [characterId], references: [id])
  status            RegistrationStatus  @default(PENDING)
  formAnswers       Json
  raiderioSnapshot  Json
  reviewedById      String?
  reviewedBy        User?               @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  rejectionReason   String?
  // Zápisné se platí ve hře (poslané zlato), takže ho aplikace neumí ověřit
  // sama - moderátor nebo admin potvrdí, že peníze dorazily. Prázdné
  // entryFeePaidAt znamená nezaplaceno.
  entryFeePaidAt        DateTime?
  entryFeeConfirmedById String?
  entryFeeConfirmedBy   User?    @relation("EntryFeeConfirmedBy", fields: [entryFeeConfirmedById], references: [id])
  entryFeeNote          String?
  createdAt         DateTime            @default(now())

  @@index([seasonId, status])
  @@unique([seasonId, characterId])
}

// ---------- Teams ----------

model Team {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  name      String
  createdAt DateTime @default(now())

  members TeamMembership[]
  matches Match[]
  reroll  TeamReroll?
  notes   TeamNote[]

  @@index([seasonId])
}

/// Reroll klíče. Každý tým má na celou soutěž jeden - zapíše ho kdokoli
/// z týmu, opravit (smazat) ho může jen admin.
///
/// Dungeony se ukládají názvem, stejně jako u MatchResult: záznam je historie
/// a nesmí se změnit ani spadnout, když admin dungeon přejmenuje nebo odebere.
model TeamReroll {
  id              String    @id @default(cuid())
  /// Unikátní - tým patří jen do jedné sezóny, takže tohle drží "jeden reroll
  /// na soutěž" i při dvou současných odesláních.
  teamId          String    @unique
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fromDungeonName String
  fromKeyLevel    Int
  toDungeonName   String
  toKeyLevel      Int
  recordedById    String
  recordedBy      Character @relation("RecordedRerolls", fields: [recordedById], references: [id])
  createdAt       DateTime  @default(now())
}

/// Neveřejná poznámka admina nebo moderátora k týmu. Hráči ji nevidí.
/// Jen se přidává - zůstává historie, kdo co kdy napsal.
model TeamNote {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TeamNotes", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([teamId])
}

model TeamMembership {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  teamId      String?
  team        Team?             @relation(fields: [teamId], references: [id])
  characterId String
  character   Character         @relation(fields: [characterId], references: [id])
  roleInTeam  SpecRole
  status      MembershipStatus  @default(ACTIVE)
  joinedAt    DateTime          @default(now())
  removedAt   DateTime?

  @@index([seasonId, teamId])
  @@index([characterId])
}

// ---------- Shuffle ----------

model ShuffleRun {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  executedById String
  executedBy  User              @relation(fields: [executedById], references: [id])
  executedAt  DateTime          @default(now())
  status      ShuffleRunStatus  @default(PROPOSED)
  // Seed generátoru náhodných čísel - se stejným seedem a stejným vstupem
  // vrátí shuffle stejné varianty (kvůli dohledání, proč vyšlo, co vyšlo).
  seed        Int?

  proposals ShuffleProposal[]

  @@index([seasonId])
}

model ShuffleProposal {
  id              String     @id @default(cuid())
  shuffleRunId    String
  shuffleRun      ShuffleRun @relation(fields: [shuffleRunId], references: [id])
  variantNumber   Int
  score           Float
  ruleViolations  Json
  teamAssignments Json

  @@index([shuffleRunId])
}

// ---------- Matches ----------

model Match {
  id            String      @id @default(cuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  /// Hráč, který termín navrhl. Prázdné u termínu, který přidal rovnou admin
  /// nebo moderátor (createdById) - ten v týmu být nemusí.
  proposedById  String?
  proposedBy    Character?  @relation("ProposedBy", fields: [proposedById], references: [id])
  /// Admin nebo moderátor, který termín přidal za tým (tým ho nechtěl
  /// vyplňovat v aplikaci sám). U návrhu od hráče prázdné.
  createdById   String?
  createdBy     User?       @relation("CreatedMatches", fields: [createdById], references: [id])
  windowStart   DateTime
  windowEnd     DateTime
  status        MatchStatus @default(PROPOSED)
  /// Poznámka od toho, kdo termín navrhl (např. "sejdeme se na Discordu").
  note          String?
  // Termín potvrzuje moderátor nebo admin - hráči si ho jen navrhnou mezi sebou.
  confirmedById String?
  confirmedBy   User?       @relation("ConfirmedMatches", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())

  /// Časovač herního času, který pouští admin nebo moderátor na detailu týmu.
  /// Naměřený čas z dřívějších úseků (bez právě běžícího).
  timerElapsedSeconds Int       @default(0)
  /// Kdy se časovač naposled spustil. Prázdné = pozastavený nebo nespuštěný.
  timerStartedAt      DateTime?

  results MatchResult[]

  @@index([teamId])
  @@index([windowStart])
}

/// Kdy má hráč čas. Z překryvů dostupností celého týmu se skládá návrh termínu.
model Availability {
  id          String    @id @default(cuid())
  seasonId    String
  season      Season    @relation(fields: [seasonId], references: [id])
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  start       DateTime
  end         DateTime
  note        String?
  createdAt   DateTime  @default(now())

  @@index([seasonId, characterId])
  @@index([seasonId, start])
}

model MatchResult {
  id                 String        @id @default(cuid())
  matchId            String
  match              Match         @relation(fields: [matchId], references: [id])
  dungeonName        String
  keyLevel           Int
  clearTimeSeconds   Int
  source             ResultSource
  screenshotUrl      String?
  /// Id běhu na Raider.io - podle něj se pozná, že už je běh nahraný,
  /// a dá se z něj složit zpětný odkaz.
  raiderioRunId      Int?
  rawRaiderioData     Json?
  isValid            Boolean       @default(false)
  invalidReason      String?
  isOfficial         Boolean       @default(false)
  /// Ručně zadaný běh, který tým nedokončil a pokus vzdal. Do bodů se nepočítá
  /// nikdy, ale čas i screenshot má povinné jako každý ručně zadaný běh -
  /// čas strávený na pokusu se týmu počítá do časového limitu zápasu.
  abandoned          Boolean       @default(false)
  /// Kdy běh skončil (z Raider.io, u ručního zadání od týmu). Podle toho se
  /// řadí čerpání časového limitu. Starší záznamy ho nemají - berou čas zápisu.
  completedAt        DateTime?
  /// Tímhle během (nebo dřívějším) tým vyčerpal časový limit zápasu - nepočítá
  /// se. Odvozené, přepočítává recomputeTimeBudget po každé změně výsledků.
  overTimeLimit      Boolean       @default(false)
  /// Moderátor běh uznal i přes vyčerpaný časový limit. Schválně oddělené od
  /// verifiedById: ověřený screenshot neznamená souhlas s překročením limitu.
  timeLimitOverride  Boolean       @default(false)
  /// Ubírá z herního času zápasu: začal v termínu (po začátku okna, nejpozději
  /// 23:59 dne termínu), hraje ho tým a dungeon je v rotaci. Bodovaný,
  /// nestihnutý i vzdaný běh ano; běh mimo termín, s cizím hráčem nebo mimo
  /// rotaci ne. Počítá se při zápisu (evaluateRun).
  countsTowardTimeLimit Boolean    @default(true)
  points             Float?
  /// Kdo o platnosti rozhodl ručně. U ručně zadaného běhu (source SCREENSHOT)
  /// prázdná hodnota znamená "čeká na ověření moderátorem".
  verifiedById       String?
  verifiedBy         User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt          DateTime      @default(now())

  screenshot         ResultScreenshot?

  @@index([matchId])
  @@unique([matchId, raiderioRunId])
}

/// Screenshot ručně zadaného běhu (MatchResult se source SCREENSHOT).
///
/// Leží v databázi, ne na disku: jede se stávajícími zálohami pg_dump a nezávisí
/// na tom, jestli má server trvalý disk. Samostatná tabulka proto, aby výpisy
/// výsledků netahaly obrázky s sebou.
model ResultScreenshot {
  id        String      @id @default(cuid())
  resultId  String      @unique
  result    MatchResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  /// Typ podle obsahu souboru (detectImageType), ne podle toho, co tvrdí prohlížeč.
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime    @default(now())
}

// ---------- Audit & Discord ----------

/// Neúspěšná přihlášení pro omezení počtu pokusů. Úspěšná se nezaznamenávají -
/// po přihlášení se záznamy toho jména mažou.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// Vždycky malými písmeny, ať limit neobejde jiná velikost písmen.
  username  String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ipAddress, createdAt])
}

/// Pokusy o registraci pro omezení jejich počtu. Zapisují se všechny, i
/// neúspěšné - limit chrání i volání Raider.io, které registrace dělá.
model RegistrationAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

/// Jednorázový odkaz na nastavení nového hesla.
///
/// Aplikace nemá SMTP, takže odkaz vydá admin nebo moderátor a pošle ho
/// hráči na Discord. Heslo si nastaví hráč sám - nikdo ho nevidí a nikdo
/// nesahá do databáze.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("ResetForUser", fields: [userId], references: [id])
  /// Uložený je jen SHA-256 otisk tokenu. Kdo si přečte databázi, odkaz z ní
  /// nesestaví - stejný důvod, proč se nikde neukládá heslo v čitelné podobě.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Vyplněný čas znamená spotřebovaný odkaz. Token je na jedno použití.
  usedAt     DateTime?
  /// Kdo odkaz vydal. Prázdné znamená vydání záchranným skriptem přímo na
  /// serveru - ten se používá, když se nemá kdo přihlásit (viz README).
  issuedById String?
  issuedBy   User?     @relation("ResetIssuedBy", fields: [issuedById], references: [id])
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actionType String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model DiscordEvent {
  id        String             @id @default(cuid())
  eventType DiscordEventType
  payload   Json
  sentAt    DateTime?
  status    DiscordEventStatus @default(PENDING)
  createdAt DateTime           @default(now())
}
