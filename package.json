{
  "name": "wow-mplus-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "dotenv -v NEXT_DIST_DIR=.next-build -- next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "backup:db": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "dev:test": "dotenv -e .env.test -- next dev",
    "prisma:migrate:test": "dotenv -e .env.test -- prisma migrate dev",
    "prisma:studio:test": "dotenv -e .env.test -- prisma studio",
    "prisma:seed:test": "dotenv -e .env.test -- prisma db seed",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset --force",
    "seed:players:test": "dotenv -e .env.test -- tsx scripts/seed-test-players.ts",
    "check:shuffle": "tsx scripts/check-shuffle.ts",
    "check:permissions": "tsx scripts/check-permissions.ts",
    "check:availability": "tsx scripts/check-availability.ts",
    "check:calendar": "tsx scripts/check-calendar.ts",
    "check:scoring": "tsx scripts/check-scoring.ts",
    "check:stats": "tsx scripts/check-stats.ts",
    "seed:run-team:test": "dotenv -e .env.test -- tsx scripts/seed-run-team.ts",
    "check:match-result": "tsx scripts/check-match-result.ts",
    "check:result-flow:test": "dotenv -e .env.test -- tsx scripts/check-result-flow.ts",
    "check:leaderboard": "tsx scripts/check-leaderboard.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.18.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
