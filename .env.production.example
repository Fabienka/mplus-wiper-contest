# Produkcni promenne prostredi. Vyplnene doplnky ulozit na server jako
# .env.production do korenu aplikace (vedle package.json) - deploy skript
# (scripts/deploy.sh) je odtud nacte jako skutecne promenne prostredi.
#
# NIKDY tento vyplneny soubor necommitovat do gitu.

# Systemova zona serveru - MUSI byt Europe/Prague, jinak produkce pri startu
# spadne (viz README, sekce Casova zona).
TZ=Europe/Prague

NODE_ENV=production

PORT=3200

# Pripojeni k produkcnimu PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/wow_mplus_app"

# NextAuth - vygenerovano prave ted pro tohle nasazeni (openssl rand -base64 32).
# Pouzij ho jen jednou, pro jine nasazeni si vygeneruj vlastni.
NEXTAUTH_SECRET="bZlE9nNiaGt7MOM2y+WkNWM/POe52UZPj7kOG01H5IY="

# Verejna adresa vcetne https:// - DOPLNIT.
NEXTAUTH_URL="https://TVOJE-DOMENA.cz"

# Jen pri prvnim seedu (npm run prisma:seed). Min. 12 znaku, jinak seed
# na produkci selze. Po prvnim seedu je muzes z .env.production zase smazat.
SEED_ADMIN_PASSWORD=""
SEED_MODERATOR_PASSWORD=""

# Nepovinne.
RAIDERIO_API_BASE="https://raider.io/api/v1"
DISCORD_WEBHOOK_URL=""
